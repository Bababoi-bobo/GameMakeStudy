# This .gitignore file should be placed at the root of your Unity project.
#
# Recommended: Visual Studio / VS Code / JetBrains Rider

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]serSettings/

# Asset meta files must be kept, even if they contain no data.
# They maintain the connections between assets and the game objects that use them.
# !/[Aa]ssets/**/*.meta

# If this is a project for a specific platform, you can ignore the project files for that platform
# /[Cc]apProject/
# /[Pp]roj.android/
# /[Pp]roj.ios/

# If this is a project for a specific platform, you can ignore the specific build product
# /[Rr]elease/

# Ignore Autogenerated Visual Studio or MonoDevelop files
[Dd]erivedData/
[Aa]ssets/AssetStoreTools*
[Vv]isualStudio.osx/
.plastic/
.DS_Store
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
*.VC.opendb

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage
*.bundle

# Crashlytics generated file
crashlytics-build.properties

# Packed Assets
/[Aa]ssets/[Aa]ddressableAssetsData/*/[Ll]ocalBuildData/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
